{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/qa/behavior-run.schema.json",
  "title": "Creator Toolchain behavior case run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "commit_sha",
    "package_payload_sha256",
    "catalog_sha256",
    "codex_version",
    "model_version",
    "harness_version",
    "source_mode",
    "prompt",
    "expected_skill",
    "selected_skill",
    "raw_response_path",
    "raw_response_sha256",
    "evaluator",
    "evaluator_version",
    "required_observations",
    "prohibited_observations",
    "result",
    "started_at",
    "finished_at",
    "exit_code"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "codex_version": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "harness_version": {"type": "string", "minLength": 1},
    "source_mode": {"enum": ["plugin-only", "repo-local"]},
    "prompt": {"type": "string", "minLength": 1},
    "expected_skill": {"type": "string", "minLength": 1},
    "selected_skill": {"type": "string", "minLength": 1},
    "raw_response_path": {"type": "string", "minLength": 1},
    "raw_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator": {"type": "string", "minLength": 1},
    "evaluator_version": {"type": "string", "minLength": 1},
    "required_observations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["observation", "result", "evidence_excerpt", "response_line_start", "response_line_end", "confidence"], "properties": {"observation": {"type": "string", "minLength": 1}, "result": {"enum": ["PASS", "FAIL", "ABSENT", "PRESENT"]}, "evidence_excerpt": {"type": "string"}, "response_line_start": {"type": ["integer", "null"], "minimum": 1}, "response_line_end": {"type": ["integer", "null"], "minimum": 1}, "confidence": {"type": "number", "minimum": 0}}}},
    "prohibited_observations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["observation", "result", "evidence_excerpt", "response_line_start", "response_line_end", "confidence"], "properties": {"observation": {"type": "string", "minLength": 1}, "result": {"enum": ["PASS", "FAIL", "ABSENT", "PRESENT"]}, "evidence_excerpt": {"type": "string"}, "response_line_start": {"type": ["integer", "null"], "minimum": 1}, "response_line_end": {"type": ["integer", "null"], "minimum": 1}, "confidence": {"type": "number", "minimum": 0}}}},
    "result": {"enum": ["PASS", "FAIL", "ERROR"]},
    "started_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "finished_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "exit_code": {"type": "integer"},
    "error": {"type": "string", "minLength": 1}
  }
}
