{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/project/ledger-event.schema.json",
  "title": "Creator Toolchain project ledger event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "ts", "sequence", "phase", "task_id", "artifact", "status", "evidence_path", "notes"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVENT-[A-F0-9]{8,64}$"},
    "ts": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "sequence": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["intake", "gate", "approval", "scaffold", "handoff"]},
    "task_id": {"type": "string", "minLength": 1},
    "artifact": {"type": "string", "minLength": 1},
    "status": {"enum": ["DONE", "DONE_WITH_CONCERNS", "NEEDS_CONTEXT", "BLOCKED", "IN_PROGRESS"]},
    "evidence_path": {"type": "string"},
    "notes": {"type": "string"}
  }
}
