{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/project/execution-handoff.schema.json",
  "title": "Creator Toolchain execution handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_plan", "target_skill", "quality_gate_result", "approval_status", "approval_decision", "approved_by", "approved_at", "artifact_paths", "open_questions", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PROJECT-[A-F0-9]{8,64}$"},
    "source_plan": {"type": "string", "pattern": "^\\.creator/plans/[a-z0-9-]+/PLANNING\\.md$"},
    "target_skill": {"const": "creator-execution-cycle"},
    "quality_gate_result": {"enum": ["pass", "pass_with_non_blocking_questions"]},
    "approval_status": {"const": "approved"},
    "approval_decision": {"const": "handoff-to-execution"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "artifact_paths": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
