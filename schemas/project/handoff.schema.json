{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/project/handoff.schema.json",
  "title": "Creator Toolchain intake handoff model",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "source_plan", "target_skill", "quality_gate_result", "approval_status", "handoff_decision", "open_questions", "updated_at"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PROJECT-[A-F0-9]{8,64}$"},
    "source_plan": {"const": "PLANNING.md"},
    "target_skill": {"const": "creator-execution-cycle"},
    "quality_gate_result": {"enum": ["not_evaluated", "pass", "pass_with_non_blocking_questions", "fail_needs_more_planning"]},
    "approval_status": {"enum": ["pending", "approved", "rejected"]},
    "handoff_decision": {"enum": ["planning-required", "scaffold-only", "handoff-to-execution"]},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
