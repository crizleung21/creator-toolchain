{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/project/state-registration-proposal.schema.json",
  "title": "Creator Toolchain project state-registration proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "operation", "status", "target_surface", "owner_skill", "requested_by", "source_plan", "proposal_path", "project", "evidence_paths", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proposal_id": {"type": "string", "pattern": "^PROPOSAL-[A-F0-9]{8,64}$"},
    "operation": {"const": "register-project"},
    "status": {"const": "staged"},
    "target_surface": {"const": ".creator/projects.json"},
    "owner_skill": {"const": "creator-workspace-manager"},
    "requested_by": {"const": "creator-intake-planner"},
    "source_plan": {"type": "string", "pattern": "^\\.creator/plans/[a-z0-9-]+/PLANNING\\.md$"},
    "proposal_path": {"type": "string", "pattern": "^\\.creator/state-proposals/PROJECT-[A-F0-9]{8,64}\\.json$"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "title", "project_type", "status", "plan_path", "last_summary", "created_at", "updated_at"],
      "properties": {
        "project_id": {"type": "string", "pattern": "^PROJECT-[A-F0-9]{8,64}$"},
        "title": {"type": "string", "minLength": 1},
        "project_type": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "approved"]},
        "plan_path": {"type": "string", "pattern": "^\\.creator/plans/[a-z0-9-]+/PLANNING\\.md$"},
        "last_summary": {"type": ["string", "null"]},
        "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
        "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
      }
    },
    "evidence_paths": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
