{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/project/intake-state.schema.json",
  "title": "Creator Toolchain intake state model",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "stage", "quality_gate_result", "answered_sections", "unanswered_sections", "blocking_questions", "non_blocking_questions", "next_prompt", "updated_at"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PROJECT-[A-F0-9]{8,64}$"},
    "stage": {"enum": ["ideating", "planned", "graduated", "launched", "archived"]},
    "quality_gate_result": {"enum": ["not_evaluated", "pass", "pass_with_non_blocking_questions", "fail_needs_more_planning"]},
    "answered_sections": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unanswered_sections": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "blocking_questions": {"type": "array", "items": {"type": "string"}},
    "non_blocking_questions": {"type": "array", "items": {"type": "string"}},
    "next_prompt": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
