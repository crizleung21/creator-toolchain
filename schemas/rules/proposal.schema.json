{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/rules/proposal.schema.json",
  "title": "Creator Toolchain rule proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "operation",
    "status",
    "owner_skill",
    "requested_by",
    "source",
    "rationale",
    "affected_domains",
    "expected_behavior_change",
    "review_date",
    "payload",
    "created_at",
    "updated_at",
    "approved_by",
    "approved_at",
    "decision_id",
    "rejection_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^PROPOSAL-[A-F0-9]{8,64}$"
    },
    "operation": {
      "enum": [
        "create-domain",
        "toggle-domain",
        "add-rule",
        "remove-rule",
        "replace-rule",
        "add-command",
        "exclude"
      ]
    },
    "status": {
      "enum": [
        "staged",
        "approved",
        "rejected"
      ]
    },
    "owner_skill": {
      "const": "creator-rule-router"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "affected_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_behavior_change": {
      "type": "string",
      "minLength": 1
    },
    "review_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "payload": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "decision_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^RULEDEC-[A-F0-9]{8,64}$"
    },
    "rejection_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
