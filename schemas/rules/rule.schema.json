{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/rules/rule.schema.json",
  "title": "Creator Toolchain rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "severity",
    "text",
    "status",
    "scope",
    "source",
    "created_at",
    "updated_at",
    "review_date"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "disabled",
        "deprecated"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "review_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
