{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/rules/command.schema.json",
  "title": "Creator Toolchain rule command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "trigger",
    "workflow",
    "status",
    "source",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "disabled",
        "deprecated"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
