{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/rules/domain.schema.json",
  "title": "Creator Toolchain rule domain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_id",
    "enabled",
    "priority",
    "scope",
    "trigger_keywords",
    "rules",
    "commands",
    "exclude_patterns",
    "decision_refs",
    "owner",
    "updated_at"
  ],
  "properties": {
    "domain_id": {
      "type": "string",
      "pattern": "^(GLOBAL|[a-z][a-z0-9-]{1,63})$"
    },
    "enabled": {
      "type": "boolean"
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "trigger_keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exclude_patterns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner": {
      "const": "creator-rule-router"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
