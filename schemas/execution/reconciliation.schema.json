{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/execution/reconciliation.schema.json",
  "title": "Creator Toolchain execution reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "sequence", "status", "planned_tasks", "actual_tasks", "deviations", "concerns", "state_update_proposal", "recommended_next_action", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PROJECT-[A-F0-9]{8,64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "status": {"enum": ["READY", "DONE", "DONE_WITH_CONCERNS", "RECOVERY_REQUIRED"]},
    "planned_tasks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "actual_tasks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "deviations": {"type": "array", "items": {"type": "string"}},
    "concerns": {"type": "array", "items": {"type": "string"}},
    "state_update_proposal": {"type": ["string", "null"]},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
