{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/execution/state-update-proposal.schema.json",
  "title": "Creator Toolchain execution state update proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "operation",
    "status",
    "target_surface",
    "owner_skill",
    "requested_by",
    "project_id",
    "execution_status",
    "source_execution",
    "reconciliation_record",
    "reconciliation_markdown",
    "summary",
    "verified_tasks",
    "concerns",
    "recommended_next_action",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proposal_id": {"type": "string", "pattern": "^PROPOSAL-[A-F0-9]{8,64}$"},
    "operation": {"const": "update-project-execution"},
    "status": {"const": "staged"},
    "target_surface": {"const": ".creator/projects.json"},
    "owner_skill": {"const": "creator-workspace-manager"},
    "requested_by": {"const": "creator-execution-cycle"},
    "project_id": {"type": "string", "pattern": "^PROJECT-[A-F0-9]{8,64}$"},
    "execution_status": {"enum": ["DONE", "DONE_WITH_CONCERNS"]},
    "source_execution": {"type": "string", "pattern": "^\\.creator/executions/PROJECT-[A-F0-9]{8,64}$"},
    "reconciliation_record": {"type": "string", "pattern": "^\\.creator/executions/PROJECT-[A-F0-9]{8,64}/RECONCILIATION-[0-9]{3}\\.json$"},
    "reconciliation_markdown": {"type": "string", "pattern": "^\\.creator/executions/PROJECT-[A-F0-9]{8,64}/RECONCILIATION-[0-9]{3}\\.md$"},
    "summary": {"type": "string", "pattern": "^\\.creator/executions/PROJECT-[A-F0-9]{8,64}/SUMMARY-[0-9]{3}\\.md$"},
    "verified_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "evidence_path", "evidence_hash"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^TASK-[A-F0-9]{8,64}$"},
          "evidence_path": {"type": "string", "minLength": 1},
          "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "concerns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
