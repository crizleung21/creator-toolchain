{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/execution/execution-state.schema.json",
  "title": "Creator Toolchain execution lifecycle state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_handoff", "current_state", "sequence", "created_at", "updated_at", "history", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PROJECT-[A-F0-9]{8,64}$"},
    "source_handoff": {"type": "string", "pattern": "^\\.creator/handoffs/PROJECT-[A-F0-9]{8,64}\\.json$"},
    "current_state": {"enum": ["PLANNED", "APPROVED", "EXECUTING", "VERIFYING", "RECONCILING", "DONE", "DONE_WITH_CONCERNS", "NEEDS_CONTEXT", "BLOCKED", "RECOVERING"]},
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "from_state", "to_state", "actor", "reason", "ts"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "from_state": {"type": ["string", "null"]},
          "to_state": {"enum": ["PLANNED", "APPROVED", "EXECUTING", "VERIFYING", "RECONCILING", "DONE", "DONE_WITH_CONCERNS", "NEEDS_CONTEXT", "BLOCKED", "RECOVERING"]},
          "actor": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "ts": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "tasks", "ledger", "blocker", "recovery_plan", "reconciliation", "summary", "state_update_proposal"],
      "properties": {
        "plan": {"type": "string", "minLength": 1},
        "tasks": {"type": "string", "minLength": 1},
        "ledger": {"type": "string", "minLength": 1},
        "blocker": {"type": ["string", "null"]},
        "recovery_plan": {"type": ["string", "null"]},
        "reconciliation": {"type": ["string", "null"]},
        "summary": {"type": ["string", "null"]},
        "state_update_proposal": {"type": ["string", "null"]}
      }
    }
  }
}
