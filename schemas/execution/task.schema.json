{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/execution/task.schema.json",
  "title": "Creator Toolchain execution task set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PROJECT-[A-F0-9]{8,64}$"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "title", "status", "acceptance_criteria", "affected_files", "verification", "created_at", "updated_at"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^TASK-[A-F0-9]{8,64}$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["PLANNED", "EXECUTING", "EXECUTED", "VERIFIED", "FAILED", "BLOCKED"]},
          "acceptance_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "affected_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "command", "expected_result", "actual_result", "evidence_path", "evidence_hash", "status", "verified_at"],
            "properties": {
              "method": {"type": "string", "minLength": 1},
              "command": {"type": ["string", "null"]},
              "expected_result": {"type": "string", "minLength": 1},
              "actual_result": {"type": ["string", "null"]},
              "evidence_path": {"type": ["string", "null"]},
              "evidence_hash": {"type": ["string", "null"]},
              "status": {"enum": ["NOT_RUN", "PASS", "FAIL"]},
              "verified_at": {"type": ["string", "null"]}
            }
          },
          "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
          "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
        }
      }
    }
  }
}
