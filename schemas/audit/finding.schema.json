{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/audit/finding.schema.json",
  "title": "Creator Toolchain immutable audit finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "finding_id", "title", "observation", "interpretation", "judgment", "severity", "severity_definition", "confidence", "confidence_band", "evidence_quality", "evidence_sources", "disagreement_state", "disagreements", "limitations", "status", "issued_by", "issued_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "audit_id": {"type": "string", "pattern": "^AUDIT-[A-Z0-9-]+$"},
    "finding_id": {"type": "string", "pattern": "^FIND-[A-F0-9]{8,64}$"},
    "title": {"type": "string", "minLength": 1},
    "observation": {"type": "string", "minLength": 1},
    "interpretation": {"type": "string", "minLength": 1},
    "judgment": {"type": "string", "minLength": 1},
    "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
    "severity_definition": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0},
    "confidence_band": {"enum": ["low", "medium", "high", "very_high"]},
    "evidence_quality": {"enum": ["weak", "moderate", "strong", "direct"]},
    "evidence_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^.+#L[0-9]+-L[0-9]+@sha256:[a-f0-9]{64}$"}},
    "disagreement_state": {"enum": ["none", "noted", "material", "unresolved"]},
    "disagreements": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "status": {"const": "active"},
    "issued_by": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
