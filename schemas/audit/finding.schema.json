{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/audit/finding.schema.json",
  "title": "Creator Toolchain audit finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "title", "observation", "interpretation", "judgment", "severity", "confidence", "evidence_quality", "evidence_sources", "disagreements", "limitations", "status", "issued_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "finding_id": {"type": "string", "pattern": "^FIND-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "observation": {"type": "string", "minLength": 1},
    "interpretation": {"type": "string", "minLength": 1},
    "judgment": {"type": "string", "minLength": 1},
    "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
    "confidence": {"type": "number", "minimum": 0},
    "evidence_quality": {"enum": ["weak", "moderate", "strong", "direct"]},
    "evidence_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "disagreements": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["active", "corrected", "superseded"]},
    "issued_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
