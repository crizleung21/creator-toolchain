{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/audit/correction-addendum.schema.json",
  "title": "Creator Toolchain immutable finding correction addendum",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "addendum_id", "source_finding", "correction_type", "new_evidence", "preserves_original", "original_sha256", "previous_judgment", "updated_judgment", "resulting_status", "reason", "issued_by", "issued_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "audit_id": {"type": "string", "pattern": "^AUDIT-[A-Z0-9-]+$"},
    "addendum_id": {"type": "string", "pattern": "^ADDENDUM-[A-F0-9]{8,64}$"},
    "source_finding": {"type": "string", "pattern": "^FIND-[A-F0-9]{8,64}$"},
    "correction_type": {"enum": ["clarify", "correct", "supersede"]},
    "new_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^.+#L[0-9]+-L[0-9]+@sha256:[a-f0-9]{64}$"}},
    "preserves_original": {"const": true},
    "original_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previous_judgment": {"type": "string", "minLength": 1},
    "updated_judgment": {"type": "string", "minLength": 1},
    "resulting_status": {"enum": ["active", "corrected", "superseded"]},
    "reason": {"type": "string", "minLength": 1},
    "issued_by": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
