{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/audit/correction-addendum.schema.json",
  "title": "Creator Toolchain finding correction addendum",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "addendum_id", "source_finding", "correction_type", "new_evidence", "preserves_original", "updated_judgment", "issued_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "addendum_id": {"type": "string", "pattern": "^ADDENDUM-[A-Z0-9-]+$"},
    "source_finding": {"type": "string", "pattern": "^FIND-[A-Z0-9-]+$"},
    "correction_type": {"enum": ["clarify", "correct", "supersede"]},
    "new_evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "preserves_original": {"const": true},
    "updated_judgment": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
