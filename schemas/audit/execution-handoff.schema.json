{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/audit/execution-handoff.schema.json",
  "title": "Creator Toolchain audit execution handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "handoff_id", "target_skill", "source_findings", "tasks", "dependency_graph", "risks", "verification_gates", "rollback_criteria", "authorization_status", "authorized_by", "authorized_at", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "audit_id": {"type": "string", "pattern": "^AUDIT-[A-Z0-9-]+$"},
    "handoff_id": {"type": "string", "pattern": "^AUDIT-HANDOFF-[A-F0-9]{8,64}$"},
    "target_skill": {"const": "creator-execution-cycle"},
    "source_findings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FIND-[A-F0-9]{8,64}$"}},
    "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REM-[A-F0-9]{8,64}$"}},
    "dependency_graph": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "verification_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authorization_status": {"enum": ["planned", "approved"]},
    "authorized_by": {"type": ["string", "null"]},
    "authorized_at": {"type": ["string", "null"]},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"}
  }
}
