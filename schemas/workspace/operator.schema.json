{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_skill", "privacy_class", "created_at", "updated_at", "owner", "preferences"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "owner_skill": {"type": "string", "minLength": 1},
    "privacy_class": {"const": "private"},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "owner": {"type": "string", "minLength": 1},
    "preferences": {"type": "object"}
  },
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/workspace/operator.schema.json",
  "title": "Creator Toolchain operator surface"
}
