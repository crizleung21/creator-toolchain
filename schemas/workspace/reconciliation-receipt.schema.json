{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/workspace/reconciliation-receipt.schema.json",
  "title": "Creator Toolchain state reconciliation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "operation", "status", "target_surface", "project_id", "before_sha256", "after_sha256", "applied_by", "applied_at", "proposal_path", "receipt_path", "health_report"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proposal_id": {"type": "string", "pattern": "^PROPOSAL-[A-F0-9]{8,64}$"},
    "operation": {"enum": ["register-project", "update-project-execution"]},
    "status": {"const": "applied"},
    "target_surface": {"const": ".creator/projects.json"},
    "project_id": {"type": "string", "pattern": "^PROJECT-[A-F0-9]{8,64}$"},
    "before_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "after_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "applied_by": {"type": "string", "minLength": 1},
    "applied_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "proposal_path": {"type": "string", "minLength": 1},
    "receipt_path": {"type": "string", "pattern": "^\\.creator/reconciliation/PROPOSAL-[A-F0-9]{8,64}\\.json$"},
    "health_report": {"const": ".creator/health/health-report.json"}
  }
}
