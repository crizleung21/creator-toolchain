{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/workspace/health-report.schema.json",
  "title": "Creator Toolchain derived workspace health report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "calculated_at", "score", "level", "summary", "recommended_next_action", "counts", "signals"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "calculated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "score": {"type": "integer", "minimum": 0},
    "level": {"enum": ["green", "amber", "red"]},
    "summary": {"type": "string", "minLength": 1},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amber", "red"],
      "properties": {"amber": {"type": "integer", "minimum": 0}, "red": {"type": "integer", "minimum": 0}}
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal_id", "level", "weight", "path", "message"],
        "properties": {
          "signal_id": {"type": "string", "minLength": 1},
          "level": {"enum": ["amber", "red"]},
          "weight": {"type": "integer", "minimum": 1},
          "path": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
