{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_skill", "privacy_class", "created_at", "updated_at", "surfaces"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "owner_skill": {"type": "string", "minLength": 1},
    "privacy_class": {"const": "publishable_template"},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "surfaces": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["surface_id", "path", "schema", "owner_skill", "privacy_class", "required", "mutable", "archive_policy"], "properties": {"surface_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^\\.creator/[^/]+\\.json$"}, "schema": {"type": "string", "pattern": "^schemas/workspace/.+\\.schema\\.json$"}, "owner_skill": {"type": "string", "minLength": 1}, "privacy_class": {"enum": ["publishable_template", "repository_workflow_state", "private", "repository_contract"]}, "required": {"type": "boolean"}, "mutable": {"type": "boolean"}, "archive_policy": {"enum": ["retain", "archive", "replace"]}}}}
  },
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/workspace/surfaces.schema.json",
  "title": "Creator Toolchain surfaces surface"
}
