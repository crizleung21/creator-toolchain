{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_skill", "privacy_class", "created_at", "updated_at", "decisions"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "owner_skill": {"type": "string", "minLength": 1},
    "privacy_class": {"const": "repository_workflow_state"},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["decision_id", "date", "title", "status", "rationale"], "properties": {"decision_id": {"type": "string", "minLength": 1}, "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "title": {"type": "string", "minLength": 1}, "status": {"enum": ["proposed", "accepted", "rejected", "superseded"]}, "rationale": {"type": "string", "minLength": 1}}}}
  },
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/workspace/decisions.schema.json",
  "title": "Creator Toolchain decisions surface"
}
