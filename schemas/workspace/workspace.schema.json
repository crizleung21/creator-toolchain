{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/workspace/workspace.schema.json",
  "title": "Creator Toolchain workspace surface",
  "required": ["schema_version","owner_skill","privacy_class","created_at","updated_at","workspace_id","display_name","state_contract","architecture_map","active_plan"],
  "properties": {
    "schema_version": {"const":"0.4.0"},
    "owner_skill": {"type":"string","minLength":1},
    "privacy_class": {"const":"publishable_template"},
    "created_at": {"type":"string","minLength":1},
    "updated_at": {"type":"string","minLength":1},
    "workspace_id": {"type":"string","minLength":1},
    "display_name": {"type":"string","minLength":1},
    "state_contract": {"const":".creator/*.json"},
    "architecture_map": {"type":"string","minLength":1},
    "active_plan": {"type":["string","null"]}
  }
}
