{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_skill", "privacy_class", "created_at", "updated_at", "active_projects", "blocked_projects", "last_health_check", "state_divergence"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "owner_skill": {"type": "string", "minLength": 1},
    "privacy_class": {"const": "repository_workflow_state"},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "active_projects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "blocked_projects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "last_health_check": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "state_divergence": {"type": "object", "additionalProperties": false, "required": ["score", "level", "notes"], "properties": {"score": {"type": "integer", "minimum": 0}, "level": {"enum": ["green", "amber", "red"]}, "notes": {"type": "string"}}}
  },
  "$id": "https://github.com/crizleung21/creator-toolchain/schemas/workspace/state.schema.json",
  "title": "Creator Toolchain state surface"
}
