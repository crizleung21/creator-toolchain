{"schema_version":"1.0.0","project_types":[{"type_id":"creator-tooling","rigor":"standard","purpose":"Build scripts, validators, workflow tools, and skill suites.","inputs":["repository context","tool requirements","runtime constraints"],"deliverables":["working tool or script","tests","operator documentation"],"acceptance_patterns":["deterministic command output","negative-path validation","repeatable installation"],"risk_checklist":["unsafe file mutation","non-deterministic output","hidden dependencies"],"rule_domains":["GLOBAL","creator-toolchain","coding"],"audit_domains":["implementation correctness","package safety","test evidence"],"default_handoff":"creator-execution-cycle","example":"Creator asset naming checker"},{"type_id":"application","rigor":"deep","purpose":"Build a software application, UI, API, or service.","inputs":["user problem","platform constraints","data model"],"deliverables":["runnable application","tests","deployment instructions"],"acceptance_patterns":["primary user flow completes","error states are observable","interfaces match contract"],"risk_checklist":["security exposure","state corruption","deployment mismatch"],"rule_domains":["GLOBAL","coding","safety","project-execution"],"audit_domains":["architecture","security","runtime behavior"],"default_handoff":"creator-execution-cycle","example":"Creator campaign planning app"},{"type_id":"workflow","rigor":"standard","purpose":"Define a repeatable SOP or automation.","inputs":["trigger","actors","source materials"],"deliverables":["workflow specification","state transitions","verification checklist"],"acceptance_patterns":["same input yields consistent routing","handoffs are explicit","failure recovery is defined"],"risk_checklist":["implicit ownership","missing rollback","scope creep"],"rule_domains":["GLOBAL","project-execution"],"audit_domains":["handoff integrity","recoverability","operational clarity"],"default_handoff":"creator-execution-cycle","example":"AI image review workflow"},{"type_id":"utility","rigor":"tight","purpose":"Build a focused script, checker, converter, or small tool.","inputs":["input format","output format","error policy"],"deliverables":["executable utility","fixtures","usage guide"],"acceptance_patterns":["valid input succeeds","invalid input is rejected","output is deterministic"],"risk_checklist":["destructive defaults","path traversal","ambiguous exit codes"],"rule_domains":["GLOBAL","coding","safety"],"audit_domains":["correctness","input safety","determinism"],"default_handoff":"creator-execution-cycle","example":"Duplicate asset detector"},{"type_id":"characterlock-system","rigor":"deep","purpose":"Lock identity, proportions, wardrobe, and viewpoint across generated character assets.","inputs":["character references","identity attributes","generation platforms"],"deliverables":["identity specification","prompt system","consistency test set"],"acceptance_patterns":["identity survives scene changes","forbidden drift is detected","variants remain traceable"],"risk_checklist":["identity drift","reference contamination","unlicensed likeness"],"rule_domains":["GLOBAL","creator-production","safety"],"audit_domains":["visual consistency","provenance","prompt controls"],"default_handoff":"creator-execution-cycle","example":"Narrative character identity lock"},{"type_id":"headlock-system","rigor":"standard","purpose":"Preserve head, face, hair, and expression identity.","inputs":["face references","angle coverage","expression range"],"deliverables":["head identity sheet","prompt constraints","comparison checklist"],"acceptance_patterns":["landmarks remain consistent","angles are covered","expression does not change identity"],"risk_checklist":["facial drift","insufficient angle evidence","overfitting one image"],"rule_domains":["GLOBAL","creator-production","safety"],"audit_domains":["facial consistency","reference coverage"],"default_handoff":"creator-execution-cycle","example":"Portrait head consistency pack"},{"type_id":"ai-image-system","rigor":"deep","purpose":"Create a repeatable AI image generation and quality-control pipeline.","inputs":["visual brief","reference assets","model constraints"],"deliverables":["prompt architecture","generation workflow","QA rubric"],"acceptance_patterns":["brief is reproducible","outputs meet visual constraints","failed generations are classified"],"risk_checklist":["style drift","copyright risk","non-reproducible parameters"],"rule_domains":["GLOBAL","creator-production","safety"],"audit_domains":["visual quality","prompt traceability","asset provenance"],"default_handoff":"creator-execution-cycle","example":"Campaign key-visual system"},{"type_id":"ai-video-system","rigor":"deep","purpose":"Create shot, scene, motion, audio, and continuity workflows for AI video.","inputs":["story intent","shot list","reference media"],"deliverables":["scene specification","shot prompts","continuity checks"],"acceptance_patterns":["shot intent is visible","continuity survives cuts","motion constraints are respected"],"risk_checklist":["temporal drift","unsafe media","audio mismatch"],"rule_domains":["GLOBAL","creator-production","safety"],"audit_domains":["continuity","motion quality","provenance"],"default_handoff":"creator-execution-cycle","example":"Short-form narrative video pipeline"},{"type_id":"character-registry","rigor":"deep","purpose":"Maintain canonical character profiles, variants, relationships, and universe records.","inputs":["character sources","naming policy","variant rules"],"deliverables":["registry schema","profile records","validation rules"],"acceptance_patterns":["IDs are unique","variants reference canonical profiles","relationships resolve"],"risk_checklist":["duplicate identity","broken references","private data leakage"],"rule_domains":["GLOBAL","creator-production","safety"],"audit_domains":["referential integrity","privacy","taxonomy"],"default_handoff":"creator-execution-cycle","example":"Story universe character registry"},{"type_id":"slide-deck","rigor":"standard","purpose":"Produce a presentation, pitch, report, or teaching deck.","inputs":["audience","message","source evidence"],"deliverables":["slide outline","slide content","presentation QA checklist"],"acceptance_patterns":["narrative has a clear arc","claims are sourced","slides are readable"],"risk_checklist":["unsupported claims","content density","visual inconsistency"],"rule_domains":["GLOBAL","creator-production"],"audit_domains":["narrative","evidence","visual communication"],"default_handoff":"creator-execution-cycle","example":"Product strategy deck"},{"type_id":"prompt-pack","rigor":"tight","purpose":"Build reusable prompts with variables, examples, and QA criteria.","inputs":["target task","model constraints","example inputs"],"deliverables":["prompt templates","variable schema","test cases"],"acceptance_patterns":["variables are explicit","examples cover edge cases","outputs can be evaluated"],"risk_checklist":["prompt ambiguity","unsafe instructions","model-specific assumptions"],"rule_domains":["GLOBAL","creator-production","safety"],"audit_domains":["instruction quality","coverage","safety"],"default_handoff":"creator-execution-cycle","example":"AI portrait prompt pack"},{"type_id":"content-campaign","rigor":"creative","purpose":"Plan and produce a multi-channel launch or publishing campaign.","inputs":["campaign goal","audience","channels"],"deliverables":["campaign narrative","content calendar","asset matrix"],"acceptance_patterns":["each asset maps to an objective","channel adaptations are explicit","measurement is defined"],"risk_checklist":["message inconsistency","platform policy violations","unmeasured outcomes"],"rule_domains":["GLOBAL","creator-production","safety"],"audit_domains":["message alignment","channel fit","measurement"],"default_handoff":"creator-execution-cycle","example":"Build Week launch campaign"},{"type_id":"research-system","rigor":"standard","purpose":"Create a repository, toolchain, or source-analysis system.","inputs":["research question","source set","evidence standard"],"deliverables":["research protocol","evidence index","synthesis outputs"],"acceptance_patterns":["sources are traceable","claims distinguish evidence and inference","limitations are explicit"],"risk_checklist":["stale sources","citation drift","unsupported certainty"],"rule_domains":["GLOBAL","creator-toolchain","safety"],"audit_domains":["evidence quality","methodology","reproducibility"],"default_handoff":"creator-execution-cycle","example":"Repository evidence audit system"}]}
